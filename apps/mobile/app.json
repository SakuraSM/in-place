{
  "expo": {
    "name": "归位",
    "description": "家庭物品管理系统",
    "slug": "in-place",
    "scheme": "inplace",
    "version": "0.1.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许归位读取照片，用于上传物品图片和 AI 识别。",
          "cameraPermission": "允许归位使用相机，用于拍照识别和上传物品图片。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许归位使用相机扫描 InPlace 标签，用于查看、绑定或归位库存。",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inplace.mobile",
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.inplace.mobile",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "allowBackup": false
    },
    "extra": {
      "eas": {
        "projectId": "afd05e9a-91f0-4533-aabe-7fc6a4007f96"
      }
    },
    "owner": "sakurasms-organization"
  }
}
