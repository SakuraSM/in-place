{
  "name": "@inplace/mobile",
  "private": true,
  "version": "0.3.2",
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:android": "npx --yes eas-cli@18.8.1 build --platform android --profile production --non-interactive",
    "build:ios": "npx --yes eas-cli@18.8.1 build --platform ios --profile production --non-interactive",
    "build:all": "npx --yes eas-cli@18.8.1 build --platform all --profile production --non-interactive"
  },
  "dependencies": {
    "@inplace/api-client": "*",
    "@inplace/app-core": "*",
    "@inplace/domain": "*",
    "@inplace/ui": "*",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@tanstack/react-query": "^5.90.21",
    "expo": "^53.0.0",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "^16.0.0",
    "expo-linking": "~7.1.7",
    "expo-print": "~14.1.4",
    "expo-router": "^5.0.0",
    "expo-secure-store": "^14.0.0",
    "expo-sharing": "~13.1.5",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.0.10",
    "jest-expo": "~53.0.9",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.8.3"
  }
}
