NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://inplace:<database-password>@127.0.0.1:5433/inplace
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional in containers; falls back to the first CORS_ORIGIN. Recommended for public deployments.
PUBLIC_ORIGIN=http://localhost:5173
# Generate two different secrets (for example: openssl rand -hex 32).
JWT_SECRET=
APP_ENCRYPTION_KEY=
MAX_UPLOAD_SIZE_MB=10
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional extra HTTPS providers. OPENAI_BASE_URL is always allowed.
AI_PROVIDER_ALLOWED_BASE_URLS=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=1048576
AUTH_SESSION_TTL_DAYS=7
OPENAI_MODEL=gpt-4o
# AMap Web JS API key and its security code. Configure both or neither.
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=

# Docker Compose deployment uses the service hostname `postgres` instead:
# DATABASE_URL=postgres://inplace:<database-password>@postgres:5432/inplace
