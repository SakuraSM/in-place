POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DATA_DIR=./storage/postgres

WEB_PORT=8080

CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,https://your-domain.com
PUBLIC_ORIGIN=https://your-domain.com
# Generate two different secrets (for example: openssl rand -hex 32).
JWT_SECRET=
APP_ENCRYPTION_KEY=
MAX_UPLOAD_SIZE_MB=10
BACKUP_PAYLOAD_SIZE_MB=100
VITE_API_BASE_URL=/api
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_ALLOWED_BASE_URLS=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=1048576
AUTH_SESSION_TTL_DAYS=7
OPENAI_MODEL=gpt-4o
# 高德开放平台 Web端（JS API）Key 与对应安全密钥，需同时配置。
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
